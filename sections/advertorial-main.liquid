{% comment %}
  Advertorial Main Content Section
  Supports multiple content blocks: text, image, quote, list
{% endcomment %}

<div class="advertorial-main">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'text' %}
        <div class="content-block text-block" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <h2>{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.content != blank %}
            <div class="text-content">{{ block.settings.content }}</div>
          {% endif %}
        </div>

      {% when 'image' %}
        <div class="content-block image-block" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <figure>
              <img 
                src="{{ block.settings.image | img_url: '1000x' }}"
                alt="{{ block.settings.image_caption | escape }}"
                loading="lazy"
              >
              {% if block.settings.image_caption != blank %}
                <figcaption>{{ block.settings.image_caption }}</figcaption>
              {% endif %}
            </figure>
          {% endif %}
        </div>

      {% when 'quote' %}
        <div class="content-block quote-block" {{ block.shopify_attributes }}>
          <blockquote>
            {% if block.settings.quote != blank %}
              <p class="quote-text">{{ block.settings.quote }}</p>
            {% endif %}
            {% if block.settings.citation != blank %}
              <cite>— {{ block.settings.citation }}</cite>
            {% endif %}
          </blockquote>
        </div>

      {% when 'list' %}
        <div class="content-block list-block" {{ block.shopify_attributes }}>
          {% if block.settings.list_title != blank %}
            <h3>{{ block.settings.list_title }}</h3>
          {% endif %}
          {% if block.settings.list_items != blank %}
            <ul class="content-list">
              {% assign items = block.settings.list_items | split: '||' %}
              {% for item in items %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>

      {% when 'spacer' %}
        <div class="content-block spacer-block" {{ block.shopify_attributes }}>
          <div class="spacer" style="height: {{ block.settings.spacer_height }}px;"></div>
        </div>

    {% endcase %}
  {% endfor %}
</div>

<style>
  .advertorial-main {
    max-width: 800px;
    margin: 3rem auto;
  }

  .content-block {
    margin-bottom: 2.5rem;
  }

  .text-block h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #333;
  }

  .text-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #444;
  }

  .text-content p {
    margin-bottom: 1rem;
  }

  .image-block figure {
    margin: 0;
  }

  .image-block img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
  }

  .image-block figcaption {
    text-align: center;
    font-size: 0.875rem;
    color: #666;
    margin-top: 0.5rem;
    font-style: italic;
  }

  .quote-block blockquote {
    margin: 2rem 0;
    padding: 2rem;
    background-color: #f8f9fa;
    border-left: 4px solid #007bff;
    border-radius: 4px;
  }

  .quote-text {
    font-size: 1.25rem;
    font-style: italic;
    color: #333;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .quote-block cite {
    display: block;
    font-size: 1rem;
    color: #666;
    font-style: normal;
  }

  .list-block h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #333;
  }

  .content-list {
    list-style: none;
    padding: 0;
  }

  .content-list li {
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    position: relative;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .content-list li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #28a745;
    font-weight: bold;
  }

  @media screen and (max-width: 768px) {
    .text-block h2 {
      font-size: 1.5rem;
    }

    .text-content {
      font-size: 1rem;
    }

    .quote-text {
      font-size: 1.125rem;
    }
  }
</style>

{% schema %}
{
  "name": "Advertorial Main Content",
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_caption",
          "label": "Image Caption"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Quote Block",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "citation",
          "label": "Citation"
        }
      ]
    },
    {
      "type": "list",
      "name": "List Block",
      "settings": [
        {
          "type": "text",
          "id": "list_title",
          "label": "List Title"
        },
        {
          "type": "textarea",
          "id": "list_items",
          "label": "List Items",
          "info": "Separate items with || (double pipe). Example: Item 1||Item 2||Item 3. Avoid using || in your item text."
        }
      ]
    },
    {
      "type": "spacer",
      "name": "Spacer",
      "settings": [
        {
          "type": "range",
          "id": "spacer_height",
          "label": "Spacer Height",
          "min": 20,
          "max": 200,
          "step": 10,
          "default": 50,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advertorial Main Content",
      "blocks": [
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
